{
  "name": "fastdraw",
  "version": "0.1.0",
  "description": "Diagrams that an AI agent writes as text and a person edits on a canvas",
  "keywords": [
    "diagram",
    "ai",
    "agent",
    "claude-code",
    "codex",
    "svg",
    "architecture-diagram",
    "flowchart"
  ],
  "homepage": "https://fastdraw.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coccor/fastdraw.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "fastdraw": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "guide",
    "fonts",
    "agents",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "dev": "vite",
    "build:editor": "vite build",
    "typecheck": "tsc -p .",
    "test:e2e": "playwright test",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --external:@resvg/resvg-js --banner:js=\"#!/usr/bin/env node\" --outfile=dist/cli.js",
    "prepack": "npm run build:cli"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.12",
    "lucide-react": "^1.72.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
