// FastDraw default look. Copy it with "fastdraw init-look" and change anything.
// An editorial look, as a magazine's graphics desk would draw it: a white page, flat square boxes with
// a hairline outline, grey for what holds data, a serif title, and one rich colour for the subject and
// the main path. Newsreader for the title, Libre Franklin for names and details, Geist Mono for small technical labels.

canvas paper=paper

color paper  #f2f3f5
color card   #ffffff
color block  #e3e6ea
color ink    #16181d
color muted  #5b616b
color soft   #9aa0a9
color hair   #d3d7dc
color accent #6d28a8
color tint   #e4cdf5
color onaccent #ffffff
color link   #b0701a
color teal   #0f766e
color amber  #b0701a
color rose   #b3354d
color violet #6b4fa8

font sans  "Libre Franklin"
font mono  "Geist Mono"
font serif "Newsreader"

// ---- boxes ----------------------------------------------------------------
style node shape=rect radius=4 size=144x64 fill=card stroke=none sw=0 sub.font=sans sub.color=muted
    tag.color=muted tag.border=ink/0.3 tag.font=mono icon.color=accent
    use="default box: a backend, service, component or step"
style focal extends node fill=tint stroke=none sw=0 title.color=accent sub.color=ink/0.7
    tag.color=accent tag.border=accent/0.6 icon.color=accent ghost.color=accent/0.12
    use="the one or two elements the diagram is about"
style store extends node shape=path fill=teal/0.18 stroke=teal/0.5 sw=1 icon.color=teal tag.color=muted tag.border=ink/0.3
    path="M0,0.1 C0,-0.035 1,-0.035 1,0.1 L1,0.9 C1,1.035 0,1.035 0,0.9 Z M0,0.1 C0,0.235 1,0.235 1,0.1 C1,0.235 0,0.235 0,0.1"
    use="something that holds data or state"
style cloud extends node fill=link/0.2 stroke=none sw=0 icon.color=link tag.color=link tag.border=link/0.5
    use="a hosted or third-party platform"
style external extends node fill=none stroke=ink/0.55 sw=1 dash=4,3 icon.color=ink
    use="a person or system outside what you own"
style optional extends node fill=none stroke=ink/0.45 sw=1 dash=1,3 cap=round tag.color=soft tag.border=ink/0.22
    use="optional or asynchronous participant"
style sticky extends node radius=0 size=120x120 fill=#fbf3c4 stroke=none sw=0 tag.color=ink tag.border=ink/0.3
    use="a yellow sticky note: an idea, comment or open question"
style sticky-orange extends sticky fill=#f8dcd6 use="an orange sticky note: a risk or issue"
style sticky-violet extends sticky fill=#e6e0f5 use="a violet sticky note: a decision or note"

// ---- flowchart shapes -----------------------------------------------------
style step extends node size=160x48 use="flowchart action"
style terminal extends node radius=24 size=160x48 fill=block stroke=none sw=0
    use="flowchart start or end"
style terminal-focal extends terminal fill=tint title.color=accent
    use="the flowchart outcome that matters most"
style decision shape=diamond size=200x96 fill=card stroke=none sw=0
    use="flowchart yes/no question; put the text on two short lines"

// ---- regions and markers --------------------------------------------------
style zone shape=rect radius=6 fill=block stroke=none sw=0 layer=back
    title.pos=top title.align=left title.font=sans title.size=9 title.weight=700 title.color=ink title.spacing=0.12 title.caps=1
    use="a labelled region drawn behind a group of boxes; always give WxH"
style bar shape=rect radius=0 size=8x80 fill=accent/0.14 stroke=accent sw=1
    use="sequence diagram activation bar, centred on a lifeline; always give WxH"

style table shape=table radius=4 fill=card stroke=ink/0.2 sw=1 head.fill=block rule=ink/0.12
    cell.font=mono cell.size=10 detail.color=muted
    use="an entity, class or database table: a header and rows. One line per row: | id \"name\" \"type\" \"key\". Arrows can end on a row: orders.user_id -> users.id"
style matrix extends table align=center grid=1 cell.font=sans
    use="a grid of values: first row with |= for the column headings, first cell of each row is its name"
style chart shape=chart fill=none stroke=ink/0.7 sw=1 mask=0 bar.radius=0 grid.color=ink/0.1
    tick.font=mono tick.size=9 tick.color=muted
    use="axes with your numbers drawn for you: chart at x,y WxH x=\"Q1,Q2,Q3\" y=0..100, then a line per series: | bars \"Revenue\" 42 61 75"

// ---- lines ----------------------------------------------------------------
style arrow line stroke=ink sw=1.2 route=ortho radius=6 label.font=sans label.size=10 label.color=muted label.spacing=0 label.caps=0
    use="default arrow"
style primary extends arrow stroke=accent sw=2.4 label.color=accent use="the main path; at most two per diagram"
style link extends arrow stroke=link label.color=link use="an HTTP or API request crossing a boundary"
style return extends arrow dash=4,3 use="a response, or something optional or asynchronous"
style relation extends relation stroke=ink/0.8 label.font=sans label.size=10 label.spacing=0 label.caps=0
style lifeline line head=none stroke=ink/0.35 sw=1 dash=1,3 cap=round route=straight use="sequence diagram lifeline"
style rule line head=none stroke=hair sw=1 route=straight use="thin separator, e.g. above a legend"

// ---- text -----------------------------------------------------------------
style h1 text font=sans size=30 weight=700 color=ink use="diagram title, a serif headline"
style kicker text font=sans size=9.5 weight=700 color=accent spacing=0.12 caps=1 use="optional: a short category above the title, e.g. PROCESS"
style dek text font=sans size=14 color=muted use="optional: one line under the title saying what the diagram shows"
style eyebrow text font=sans size=8 weight=600 color=muted spacing=0.14 caps=1 use="small caps label, e.g. LEGEND"
style caption text font=sans size=9.5 color=muted use="small explanatory text"
style legend extends legend rule=hair title.font=sans item.size=9.5
style note text font=serif italic=1 size=14 color=muted use="a short editorial aside; at most two"
style small text font=mono size=9 color=muted use="technical detail: a port, path or command"

guidance "focal, terminal-focal and primary are the accent: the one colour on the page. Use them on at most two things in one diagram."
guidance "Never fill a shape with ink to make it stand out; use focal, or a tint such as accent/0.14."
guidance "tag= is a 3 or 4 letter type marker in the corner of a box (EXT, EDGE, API, DB). Use it on architecture boxes, not flowchart shapes."
guidance "sub= is a short second line of detail: a product name, path, port or protocol. Names of things go in the main text."
guidance "kicker and dek are optional. Add a kicker only when the diagram belongs to a named category, and a dek only when there is one clear message; most diagrams need neither."
guidance "Finish with a legend: one statement, 'legend at x,y' followed by style=\"what it means\" for each style you used."
