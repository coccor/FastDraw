look "../../looks/reference.look"
canvas 1000x452

text "Who can do what on the data platform" at 40,52 style=h1

// columns: labels at x=40 (200 wide), then one per role: x = 248 + 144*j, 136 wide
// rows: header at y=96 (52 high), then y = 160 + 40*k, 36 high

// header
corner: rect "Component" sub="vs. AD group" at 40,96 200x52 radius=6 fill=#ffffff stroke=ink/0.12 title.size=11
r1: rect "Data Engineer" sub="GRP-DATA-ENG" at 248,96 136x52 radius=6 fill=ink stroke=none title.color=#ffffff sub.color=#ffffff/0.8 title.size=11
r2: rect "Data Scientist" sub="GRP-DATA-SCI" at 392,96 136x52 radius=6 fill=ink stroke=none title.color=#ffffff sub.color=#ffffff/0.8 title.size=11
r3: rect "Analyst" sub="GRP-ANALYST" at 536,96 136x52 radius=6 fill=ink stroke=none title.color=#ffffff sub.color=#ffffff/0.8 title.size=11
r4: rect "Administrator" sub="GRP-ADMIN" at 680,96 136x52 radius=6 fill=ink stroke=none title.color=#ffffff sub.color=#ffffff/0.8 title.size=11
r5: rect "External Partner" sub="GRP-PARTNER" at 824,96 136x52 radius=6 fill=ink stroke=none title.color=#ffffff sub.color=#ffffff/0.8 title.size=11

// Object storage
c1: rect "Object storage" at 40,160 200x36 radius=4 fill=#ffffff stroke=ink/0.12 title.size=11 title.align=left
text "S3" at 228,181 style=small anchor=end
c11: rect "Write" at 248,160 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=#ffffff
c12: rect "Read" at 392,160 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=muted/0.08 title.color=muted
c13: rect "None" at 536,160 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=none title.color=soft
c14: rect "Admin" at 680,160 136x36 radius=4 title.size=10 stroke=ink/0.12 fill=ink/0.12 title.weight=600
c15: rect "None" at 824,160 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=none title.color=soft

// Query engine
c2: rect "Query engine" at 40,200 200x36 radius=4 fill=#ffffff stroke=ink/0.12 title.size=11 title.align=left
text "SQL" at 228,221 style=small anchor=end
c21: rect "Write" at 248,200 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=#ffffff
c22: rect "Read" at 392,200 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=muted/0.08 title.color=muted
c23: rect "Read" at 536,200 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=muted/0.08 title.color=muted
c24: rect "Admin" at 680,200 136x36 radius=4 title.size=10 stroke=ink/0.12 fill=ink/0.12 title.weight=600
c25: rect "Read" at 824,200 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=muted/0.08 title.color=muted

// Notebooks
c3: rect "Notebooks" at 40,240 200x36 radius=4 fill=#ffffff stroke=ink/0.12 title.size=11 title.align=left
text "PY" at 228,261 style=small anchor=end
c31: rect "Write" at 248,240 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=#ffffff
c32: rect "Write" at 392,240 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=#ffffff
c33: rect "None" at 536,240 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=none title.color=soft
c34: rect "Admin" at 680,240 136x36 radius=4 title.size=10 stroke=ink/0.12 fill=ink/0.12 title.weight=600
c35: rect "None" at 824,240 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=none title.color=soft

// BI tool
c4: rect "BI tool" at 40,280 200x36 radius=4 fill=#ffffff stroke=ink/0.12 title.size=11 title.align=left
text "DASH" at 228,301 style=small anchor=end
c41: rect "Write" at 248,280 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=#ffffff
c42: rect "Read" at 392,280 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=muted/0.08 title.color=muted
c43: rect "Write" at 536,280 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=#ffffff
c44: rect "Admin" at 680,280 136x36 radius=4 title.size=10 stroke=ink/0.12 fill=ink/0.12 title.weight=600
c45: rect "Read" sub="shared dashboards" at 824,280 136x36 radius=4 title.size=10 fill=accent/0.08 stroke=accent sw=1.4 title.color=accent sub.color=accent sub.size=8 title.weight=600

// Orchestrator
c5: rect "Orchestrator" at 40,320 200x36 radius=4 fill=#ffffff stroke=ink/0.12 title.size=11 title.align=left
text "DAG" at 228,341 style=small anchor=end
c51: rect "Write" at 248,320 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=#ffffff
c52: rect "Read" at 392,320 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=muted/0.08 title.color=muted
c53: rect "None" at 536,320 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=none title.color=soft
c54: rect "Admin" at 680,320 136x36 radius=4 title.size=10 stroke=ink/0.12 fill=ink/0.12 title.weight=600
c55: rect "None" at 824,320 136x36 radius=4 title.size=10 title.weight=400 stroke=ink/0.12 fill=none title.color=soft

// legend, by hand: the cells are tints, not styles of the look
40,380 -- 960,380 style=rule
text "Legend" at 40,400 style=eyebrow
rect at 40,412 16x12 radius=2 stroke=ink/0.12 fill=ink/0.12
text "Admin" at 64,422 style=caption
rect at 136,412 16x12 radius=2 stroke=ink/0.12 fill=#ffffff
text "Write" at 160,422 style=caption
rect at 232,412 16x12 radius=2 stroke=ink/0.12 fill=muted/0.08
text "Read" at 256,422 style=caption
rect at 328,412 16x12 radius=2 stroke=ink/0.12 fill=none
text "None" at 352,422 style=caption
rect at 424,412 16x12 radius=2 stroke=accent sw=1.4 fill=accent/0.08
text "The one rule to remember: partners read shared dashboards, nothing else" at 448,422 style=caption
