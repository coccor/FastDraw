look "../../looks/reference.look"
canvas 1000x592

// centre 500,300, radius 160 = 100%, so 1.6px per point. Eight windows, the first straight up, then clockwise.
title: text "Request demand by UTC window" at 40,52 style=h1
text "% of daily peak · 0 to 100" at 40,74 style=caption

// rings at 20, 40, 60, 80 and 100
ellipse at 468,268 64x64 fill=none stroke=ink/0.1 sw=1 overlap=ok mask=0
ellipse at 436,236 128x128 fill=none stroke=ink/0.1 sw=1 overlap=ok mask=0
ellipse at 404,204 192x192 fill=none stroke=ink/0.1 sw=1 overlap=ok mask=0
ellipse at 372,172 256x256 fill=none stroke=ink/0.1 sw=1 overlap=ok mask=0
ellipse at 340,140 320x320 fill=none stroke=ink/0.25 sw=1 overlap=ok mask=0

// one ray per window, from the centre to its value, with a ring on the end; then the name and the value outside the outer ring
500,300 -- 500,140 stroke=ink/0.14 sw=1
500,300 -- 500,249 stroke=muted sw=1.5
ellipse at 496,245 8x8 fill=paper stroke=muted sw=1.5 overlap=ok
text "00–03" at 500,110 anchor=middle size=11 weight=600 color=ink
text "32" at 500,123 anchor=middle style=small color=muted
500,300 -- 613,187 stroke=ink/0.14 sw=1
500,300 -- 520,280 stroke=muted sw=1.5
ellipse at 516,276 8x8 fill=paper stroke=muted sw=1.5 overlap=ok
text "03–06" at 627,175 size=11 weight=600 color=ink
text "18" at 627,188 style=small color=muted
500,300 -- 660,300 stroke=ink/0.14 sw=1
500,300 -- 538,300 stroke=muted sw=1.5
ellipse at 534,296 8x8 fill=paper stroke=muted sw=1.5 overlap=ok
text "06–09" at 680,302 size=11 weight=600 color=ink
text "24" at 680,315 style=small color=muted
500,300 -- 613,413 stroke=ink/0.14 sw=1
500,300 -- 566,366 stroke=muted sw=1.5
ellipse at 562,362 8x8 fill=paper stroke=muted sw=1.5 overlap=ok
text "09–12" at 627,429 size=11 weight=600 color=ink
text "58" at 627,442 style=small color=muted
500,300 -- 500,460 stroke=ink/0.14 sw=1
500,300 -- 500,460 stroke=accent sw=2
ellipse at 495,455 10x10 fill=paper stroke=accent sw=2 overlap=ok
text "12–15" at 500,488 anchor=middle size=11 weight=600 color=accent
text "100" at 500,502 anchor=middle style=small color=accent
500,300 -- 387,413 stroke=ink/0.14 sw=1
500,300 -- 407,393 stroke=muted sw=1.5
ellipse at 403,389 8x8 fill=paper stroke=muted sw=1.5 overlap=ok
text "15–18" at 373,429 anchor=end size=11 weight=600 color=ink
text "82" at 373,442 anchor=end style=small color=muted
500,300 -- 340,300 stroke=ink/0.14 sw=1
500,300 -- 378,300 stroke=muted sw=1.5
ellipse at 374,296 8x8 fill=paper stroke=muted sw=1.5 overlap=ok
text "18–21" at 320,302 anchor=end size=11 weight=600 color=ink
text "76" at 320,315 anchor=end style=small color=muted
500,300 -- 387,187 stroke=ink/0.14 sw=1
500,300 -- 449,249 stroke=muted sw=1.5
ellipse at 445,245 8x8 fill=paper stroke=muted sw=1.5 overlap=ok
text "21–24" at 373,175 anchor=end size=11 weight=600 color=ink
text "45" at 373,188 anchor=end style=small color=muted

// scale, beside the first spoke
text "20" at 494,271 style=small size=8 color=soft anchor=end
text "40" at 494,239 style=small size=8 color=soft anchor=end
text "60" at 494,207 style=small size=8 color=soft anchor=end
text "80" at 494,175 style=small size=8 color=soft anchor=end

legend at 40,520 dot.accent="12–15 UTC · the daily peak" dot.muted="Other three-hour windows" title="Distance from the centre = demand"
