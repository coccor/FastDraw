look "../../looks/reference.look"
canvas 1000x500

// rows: y = 104, 224, 344 (48px boxes, 72px between rows; the bus runs half-way between rows)
// leaves: 144 wide, 24 apart, centres x = 164, 332, 500, 668, 836; each parent is centred over its children

text "Skills, by category" at 40,52 style=h1

root: focal "Skills" at 420,104 160x48

design: node "Design" sub="ui · visual · ux" at 168,224 160x48
research: node "Research" sub="investigate · analyze" at 420,224 160x48
eng: node "Engineering" sub="ship · review · test" at 672,224 160x48

polish: cloud "polish" sub="align · space · rhythm" at 92,344 144x48
critique: cloud "critique" sub="hierarchy · density" at 260,344 144x48
investigate: cloud "investigate" sub="root cause · evidence" at 428,344 144x48
review: cloud "review" sub="pre-land diff · sql" at 596,344 144x48
ship: cloud "ship" sub="merge · deploy · verify" at 764,344 144x48

// connectors: children share the parent's start point, so the bus draws itself
root.bottom@0.5 -- design.top style=relation
root.bottom@0.5 -- research.top style=relation
root.bottom@0.5 -- eng.top style=relation

design.bottom@0.5 -- polish.top style=relation
design.bottom@0.5 -- critique.top style=relation

research.bottom -- investigate.top style=relation

eng.bottom@0.5 -- review.top style=relation
eng.bottom@0.5 -- ship.top style=relation

legend at 40,424 focal="Root" node="Category" cloud="Leaf skill"
