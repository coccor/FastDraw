look "../../looks/reference.look"
canvas 1000x528

text "Story points per sprint, by sprint" at 40,52 style=h1

// plot area 96,112 to 960,404. One series; fill.5 colours the fifth bar
vel: chart at 96,112 864x292 x="S1,S2,S3,S4,S5,S6,S7,S8" y=0..120 step=20 labels=1 key=0 ytitle="Story points per sprint"
  | bars "Velocity" 72 88 95 78 110 102 85 93 fill=soft fill.5=accent

legend at 40,456 swatch.accent="Sprint 5 · record high" swatch.soft="Other sprints"
