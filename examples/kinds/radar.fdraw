look "../../looks/reference.look"

title: text "Why we picked MinIO for the object store" at 40,52 style=h1
text "Scores 0 to 10, higher is better · rings every 2" at 40,74 style=caption

// centre 500,288, radius 160 = score 10, so 16px per point. Five axes, the first straight up, then clockwise.
// every polygon is written "at 0,0" so that its points are canvas coordinates

// rings at 2, 4, 6, 8 and 10
polygon at 0,0 points=500,256;530,278;519,314;481,314;470,278 fill=none stroke=ink/0.1 sw=1 overlap=ok mask=0
polygon at 0,0 points=500,224;561,268;538,340;462,340;439,268 fill=none stroke=ink/0.1 sw=1 overlap=ok mask=0
polygon at 0,0 points=500,192;591,258;556,366;444,366;409,258 fill=none stroke=ink/0.1 sw=1 overlap=ok mask=0
polygon at 0,0 points=500,160;622,248;575,392;425,392;378,248 fill=none stroke=ink/0.1 sw=1 overlap=ok mask=0
polygon at 0,0 points=500,128;652,239;594,417;406,417;348,239 fill=none stroke=ink/0.25 sw=1 overlap=ok mask=0

// spokes
500,288 -- 500,128 stroke=ink/0.2 sw=1
500,288 -- 652,239 stroke=ink/0.2 sw=1
500,288 -- 594,417 stroke=ink/0.2 sw=1
500,288 -- 406,417 stroke=ink/0.2 sw=1
500,288 -- 348,239 stroke=ink/0.2 sw=1

// one polygon per option, the recommended one last
ceph: polygon at 0,0 points=500,176;607,253;566,379;462,340;409,258 fill=soft/0.06 stroke=soft sw=1.5 overlap=ok mask=0
gcs: polygon at 0,0 points=500,192;637,244;575,392;444,366;393,253 fill=muted/0.06 stroke=muted sw=1.5 overlap=ok mask=0
s3: polygon at 0,0 points=500,192;652,239;585,404;453,353;378,248 fill=link/0.06 stroke=link sw=1.5 overlap=ok mask=0
minio: polygon at 0,0 points=500,144;622,248;585,404;415,404;363,244 fill=accent/0.14 stroke=accent sw=2 overlap=ok mask=0
ellipse at 496,140 8x8 fill=accent stroke=none overlap=ok
ellipse at 618,244 8x8 fill=accent stroke=none overlap=ok
ellipse at 581,400 8x8 fill=accent stroke=none overlap=ok
ellipse at 411,400 8x8 fill=accent stroke=none overlap=ok
ellipse at 359,240 8x8 fill=accent stroke=none overlap=ok

// axis names, 20px beyond the end of each spoke
text "Small-file handling" at 500,108 anchor=middle size=11 weight=600 color=ink
text "Large-object reads" at 671,236 size=11 weight=600 color=ink
text "Write throughput" at 606,438 size=11 weight=600 color=ink
text "Operational simplicity" at 394,438 anchor=end size=11 weight=600 color=ink
text "Iceberg integration" at 329,236 anchor=end size=11 weight=600 color=ink

legend at 40,476 swatch.accent="MinIO · recommended" swatch.link="Amazon S3" swatch.muted="Google Cloud Storage" swatch.soft="Ceph"
