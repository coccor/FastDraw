look "../../looks/reference.look"
canvas 1120x590
text "Why checkout got slow" at 40,52 style=h1
effect: focal "Checkout p99 latency\n4x for 90 minutes" tag="EFFECT" at 880,256 200x88
240,300 -> effect.left stroke=ink
b0: rect "DEPLOY" at 644,104 120x28 radius=4 fill=paper stroke=ink sw=0.8
b0.bottom -- 800,300 sw=1.2 stroke=ink
768,244 -- 736,244 sw=1
text "canary skipped" at 732,247 style=small anchor=end
736,188 -- 704,188 sw=1
text "config drift" at 700,191 style=small anchor=end
b1: focal "DATA" at 484,468 120x28 radius=4
b1.top -- 640,300 sw=1.2 stroke=accent
608,356 -- 576,356 sw=1
text "index missing on orders.created_at" at 572,359 style=small anchor=end
576,412 -- 544,412 sw=1
text "table 3x forecast" at 540,415 style=small anchor=end
b2: rect "RUNTIME" at 324,104 120x28 radius=4 fill=paper stroke=ink sw=0.8
b2.bottom -- 480,300 sw=1.2 stroke=ink
448,244 -- 416,244 sw=1
text "connection pool cap 20" at 412,247 style=small anchor=end
416,188 -- 384,188 sw=1
text "GC pauses" at 380,191 style=small anchor=end
b3: rect "PEOPLE" at 164,468 120x28 radius=4 fill=paper stroke=ink sw=0.8
b3.top -- 320,300 sw=1.2 stroke=ink
272,384 -- 240,384 sw=1
text "on-call handover mid-incident" at 236,387 style=small anchor=end
legend at 40,524 line.ink="Category of cause" line.accent="Confirmed root cause" line.muted="Cause looked into" focal="What was observed"
