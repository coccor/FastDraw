look "../../looks/reference.look"

// grid: 6 columns from x=184, 120px apart; 5 rows from y=136, 60px apart; cells 116x56 with a 4px gap
// fill = ink at (value / 9 * 0.65), at least 0.07: 9% is the largest value outside the focal cell
title: text "CI failures peaked on payments in sprint 4" at 40,52 style=h1
text "SPRINT" at 542,100 style=eyebrow anchor=middle
text "SERVICE" at 74,284 style=eyebrow anchor=middle rotate=-90
text "S1" at 242,124 style=small size=10 color=muted anchor=middle
