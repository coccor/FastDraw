look "../../looks/reference.look"
canvas 1000x480
// scale: Feb 2025 at x=100, 57px per month
text "How the blog design evolved" at 40,52 style=h1
text "Spacing follows real elapsed time." at 40,74 style=caption
text "2025" at 232,388 font=mono size=56 weight=600 color=ink/0.06
text "2026" at 692,388 font=mono size=56 weight=600 color=ink/0.06
axis: 80,232 -- 920,232 stroke=muted/0.45 sw=1
80,224 -- 80,240 stroke=ink/0.2 sw=1
920,224 -- 920,240 stroke=ink/0.2 sw=1
680,224 -- 680,240 stroke=ink/0.2 sw=1
text "JAN '26" at 680,254 style=eyebrow anchor=middle color=soft
100,232 -- 100,288 stroke=ink/0.3 sw=1
e1: ellipse at 96,228 8x8 fill=ink stroke=none
text "FEB 2025" at 100,304 style=eyebrow anchor=middle
text "First post" at 100,320 anchor=middle weight=600 color=ink
240,176 -- 240,232 stroke=ink/0.3 sw=1
e2: ellipse at 236,228 8x8 fill=ink stroke=none
text "APR 2025" at 240,148 style=eyebrow anchor=middle
text "Design v1" at 240,164 anchor=middle weight=600 color=ink
500,232 -- 500,288 stroke=ink/0.3 sw=1
e3: ellipse at 496,228 8x8 fill=ink stroke=none
text "SEP 2025" at 500,304 style=eyebrow anchor=middle
text "Design v2" at 500,320 anchor=middle weight=600 color=ink
text "typography pass" at 500,336 style=small anchor=middle
740,160 -- 740,232 stroke=accent sw=1
e4: ellipse at 734,226 12x12 fill=accent stroke=none
text "JAN 2026" at 740,120 style=eyebrow anchor=middle color=accent
text "Design v3" at 740,136 anchor=middle weight=600 size=14 color=ink
text "complexity budget" at 740,152 style=small anchor=middle
900,232 -- 900,288 stroke=accent sw=1
e5: ellipse at 894,226 12x12 fill=accent stroke=none
text "APR 2026 · NOW" at 900,304 style=eyebrow anchor=middle color=accent
text "Schematic skill" at 900,320 anchor=middle weight=600 color=ink
text "eight diagram types" at 900,336 style=small anchor=middle
legend at 40,408 dot.ink="Event" dot.accent="Major milestone"
