rect "RISK" at 932,362 44x12 radius=2 fill=paper stroke=accent sw=0.8 overlap=ok title.font=mono title.size=8 title.weight=400 title.color=accent

l1: node "Natural-language query" sub="RPT-120 · 8pt" at 140,448 176x48
l4: node "Alerting on anomalies" sub="RPT-121 · 5pt" at 812,448 176x48

legend at 40,536 node="Step or story" swatch.ink/0.08="Activity" focal="Riskiest story" line.accent="Release cut"
