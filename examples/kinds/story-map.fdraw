look "../../looks/reference.look"
canvas 1040x608
text "Reporting, first release" at 40,52 style=h1

mvp:   zone at 40,272 960x80 radius=0 stroke=none
later: zone at 40,432 960x80 radius=0 stroke=none
text "MVP" at 56,316 style=eyebrow
text "Release 2" at 56,396 style=eyebrow
text "Later" at 56,476 style=eyebrow

116,160 -- 116,512 style=rule dash=4,4
340,160 -- 340,512 style=rule dash=4,4
564,160 -- 564,512 style=rule dash=4,4
788,160 -- 788,512 style=rule dash=4,4

a1: node "Find the data" sub="ACTIVITY 1" at 128,96 200x64 fill=ink/0.08
a2: node "Build the report" sub="ACTIVITY 2" at 352,96 200x64 fill=ink/0.08
a3: node "Share it" sub="ACTIVITY 3" at 576,96 200x64 fill=ink/0.08
a4: node "Trust it" sub="ACTIVITY 4" at 800,96 200x64 fill=ink/0.08

s11: node "Search datasets" at 140,176 176x32 title.weight=400
s12: node "Preview rows" at 140,216 176x32 title.weight=400
s21: node "Pick columns" at 364,176 176x32 title.weight=400
s22: node "Add a chart" at 364,216 176x32 title.weight=400
s31: node "Send a link" at 588,176 176x32 title.weight=400
s41: node "Check freshness" at 812,176 176x32 title.weight=400

m1: node "Keyword search" sub="RPT-101 · 3pt" at 140,288 176x48
m2: node "Table + one chart" sub="RPT-102 · 5pt" at 364,288 176x48
m3: node "Public link" sub="RPT-103 · 2pt" at 588,288 176x48
m4: node "Last-updated stamp" sub="RPT-104 · 1pt" at 812,288 176x48

cut: 40,352 -- 1000,352 "Release cut" style=primary lpos=76,368

r1: node "Saved filters" sub="RPT-110 · 3pt" at 140,368 176x48
r2: node "Column formats" sub="RPT-111 · 2pt" at 364,368 176x48
r3: node "Scheduled email" sub="RPT-112 · 5pt" at 588,368 176x48
