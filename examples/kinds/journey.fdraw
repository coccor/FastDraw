look "../../looks/reference.look"
text "Trial to paid: the first week" at 40,52 style=h1

text "Stage 1" at 228,100 style=eyebrow anchor=middle
text "Sign up" at 228,120 weight=600 anchor=middle
text "Stage 2" at 444,100 style=eyebrow anchor=middle
text "First run" at 444,120 weight=600 anchor=middle
text "Stage 3" at 660,100 style=eyebrow anchor=middle
text "Invite team" at 660,120 weight=600 anchor=middle
text "Stage 4" at 876,100 style=eyebrow anchor=middle
text "Hit the limit" at 876,120 weight=600 anchor=middle
text "Stage 5" at 1092,100 style=eyebrow anchor=middle
text "Upgrade" at 1092,120 weight=600 anchor=middle

128,160 -- 1200,160 style=rule
128,240 -- 1200,240 style=rule
128,320 -- 1200,320 style=rule
text "High" at 112,163 style=eyebrow anchor=end
text "Neutral" at 112,243 style=eyebrow anchor=end
text "Low" at 112,323 style=eyebrow anchor=end

228,160 -- 444,240 sw=1.5
444,240 -- 660,160 sw=1.5
660,160 -- 876,320 sw=1.5 stroke=accent
876,320 -- 1092,240 sw=1.5
ellipse at 223,155 10x10 fill=muted stroke=none
ellipse at 439,235 10x10 fill=muted stroke=none
ellipse at 655,155 10x10 fill=muted stroke=none
ellipse at 871,315 10x10 fill=accent stroke=none
ellipse at 1087,235 10x10 fill=muted stroke=none

128,344 -- 1200,344 style=rule
128,440 -- 1200,440 style=rule
text "Actions" at 112,375 style=eyebrow anchor=end
text "Touchpoints" at 112,475 style=eyebrow anchor=end

text "Create workspace" at 228,372 anchor=middle
text "Import first dataset" at 444,372 anchor=middle
text "Add 3 teammates" at 660,372 anchor=middle
text "Export blocked mid-report" at 876,372 anchor=middle
text "Pick annual plan" at 1092,372 anchor=middle

rect "NO WARNING AT 80%" at 784,384 184x16 radius=2 fill=accent/0.08 stroke=accent/0.5 sw=0.8 dash=3,3
    title.font=mono title.size=8 title.weight=400 title.color=accent title.spacing=0.1
rect "PRICING PAGE IS 3 CLICKS AWAY" at 784,408 184x16 radius=2 fill=accent/0.08 stroke=accent/0.5 sw=0.8 dash=3,3
    title.font=mono title.size=8 title.weight=400 title.color=accent title.spacing=0.1

text "signup form" at 228,472 style=small anchor=middle
text "onboarding wizard" at 444,472 style=small anchor=middle
text "email invite" at 660,472 style=small anchor=middle
text "in-app modal" at 876,472 style=small anchor=middle
text "billing page" at 1092,472 style=small anchor=middle

legend at 40,520 line.muted="How the user feels" dot.accent="Lowest point" swatch.accent/0.15="What hurts there"
