look "../../looks/reference.look"
text "What to build next" at 40,68 style=h1

// the one quadrant that matters, tinted; a zone, so it is drawn behind the axes
zone at 120,96 380x172 fill=accent/0.03 stroke=none radius=0

// axes cross at 500,268; the head is at the high end
xaxis: 120,268 -> 880,268 stroke=ink/0.45 sw=1
yaxis: 500,440 -> 500,96 stroke=ink/0.45 sw=1

// one word or two at each end, beside the line
text "Low effort" at 120,284 style=eyebrow
text "High effort" at 880,284 style=eyebrow anchor=end
text "High impact" at 512,100 style=eyebrow
text "Low impact" at 512,440 style=eyebrow

// quadrant names in the outer corners
text "Do first" at 140,120 style=eyebrow size=9 color=accent weight=600
text "Major projects" at 860,120 style=eyebrow size=9 anchor=end
text "Quick wins" at 140,428 style=eyebrow size=9
text "Avoid" at 860,428 style=eyebrow size=9 anchor=end

// do first
p1: ellipse at 214,150 12x12 fill=accent stroke=none
text "Schematic skill v4" at 232,160 size=11 weight=600 color=ink
p2: ellipse at 316,212 8x8 fill=ink stroke=none
text "Update changelog" at 332,220 size=11 color=muted

// major projects
p3: ellipse at 616,152 8x8 fill=ink stroke=none
text "Design v4 refresh" at 632,160 size=11 color=muted
p4: ellipse at 756,192 8x8 fill=ink stroke=none
text "New publication" at 772,200 size=11 color=muted

// quick wins
p5: ellipse at 256,332 8x8 fill=ink stroke=none
text "Fix footer link" at 272,340 size=11 color=muted
p6: ellipse at 356,392 8x8 fill=ink stroke=none
text "Update OG tags" at 372,400 size=11 color=muted

// avoid
p7: ellipse at 636,392 8x8 fill=ink stroke=none
text "Rewrite build pipeline" at 652,400 size=11 color=muted
p8: ellipse at 776,332 8x8 fill=ink stroke=none
text "Port to Nuxt" at 792,340 size=11 color=muted


legend at 40,472 dot.accent="Start tomorrow" dot.ink="Candidate project"
