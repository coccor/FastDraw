look "../../looks/reference.look"
canvas 1000x448

// projection: screen x = 440 + x - y · screen y = 76 + (x + y)/2 - z   (x runs right and down, y left and down, z up)
// floor plan 360 x 240, slab 6 thick (floor at z=6), walls 22 high, desks 10, counters 14 to 16
// painted back to front: a box comes after every box that lies behind it

