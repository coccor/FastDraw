look "../../looks/reference.look"
canvas 1000x490

text "Checkout service, production" at 40,60 style=h1

// zones: real boundaries, 16px around their hosts, 32px at the top for the name
edge: zone "Edge" at 72,92 232x132 dash=4,4 stroke=ink/0.2
prod: zone "Prod / eu-west-1" at 384,92 232x304 dash=4,4 stroke=ink/0.2
data: zone "Data" at 696,92 232x304 dash=4,4 stroke=ink/0.2

// hosts: a box with a type tag, its name as text, and one chip per thing installed on it
cdn: cloud tag="CDN" at 88,124 200x84
text "Cloudflare" at 188,164 weight=600 anchor=middle
store at 96,176 184x24 radius=4
text "edge-cache" at 104,192
text "v1.2" at 272,192 style=small anchor=end

ingress: node tag="POD" at 400,124 200x84
text "ingress" at 500,164 weight=600 anchor=middle
store at 408,176 184x24 radius=4
text "nginx-ingress" at 416,192
text "v1.11" at 584,192 style=small anchor=end

app: node tag="POD" at 400,264 200x116
text "app" at 500,304 weight=600 anchor=middle
rect "x3" at 564,272 28x12 radius=2 fill=none stroke=ink/0.4 sw=0.8 title.font=mono title.size=8 title.weight=400
store at 408,316 184x24 radius=4
text "checkout-api" at 416,332
text "v2.4.1" at 584,332 style=small anchor=end
store at 408,348 184x24 radius=4
text "sidecar-otel" at 416,364
text "v0.9" at 584,364 style=small anchor=end

standby: store tag="MANAGED" at 712,124 200x84
text "rds-standby" at 812,164 weight=600 anchor=middle
store at 720,176 184x24 radius=4
text "postgres" at 728,192
text "16.2" at 896,192 style=small anchor=end

primary: focal tag="MANAGED" at 712,280 200x84
text "rds-primary" at 812,320 weight=600 anchor=middle
store at 720,332 184x24 radius=4
text "postgres" at 728,348
text "16.2" at 896,348 style=small anchor=end

// network paths: protocol and port on every one
cdn -> ingress "HTTPS:443" style=link lpos=344,156
ingress -> app "HTTP:8080"
app -> primary "TLS:5432" style=link lpos=656,312
primary -> standby "WAL stream" style=return

legend at 40,420 focal="Single point of failure" node="Pod" store="Standby / installed artifact" cloud="Managed edge" link="Crosses a zone" arrow="Inside a zone" return="Replication"
