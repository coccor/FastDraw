look "../../looks/reference.look"
canvas 1416x616

text "From order to closed ticket" at 40,60 style=h1

// lanes: one per actor, 96 high, every second one tinted; names in the left margin
zone at 40,136 1336x96 radius=0 stroke=none
zone at 40,328 1336x96 radius=0 stroke=none
40,136 -- 1376,136 style=rule
40,232 -- 1376,232 style=rule
40,328 -- 1376,328 style=rule
40,424 -- 1376,424 style=rule
40,520 -- 1376,520 style=rule
168,136 -- 168,520 stroke=ink/0.2 sw=1
text "Customer" at 104,187 style=eyebrow anchor=middle
text "Support" at 104,283 style=eyebrow anchor=middle
text "Warehouse" at 104,379 style=eyebrow anchor=middle
text "Finance" at 104,475 style=eyebrow anchor=middle

// steps: one column each, 152 apart, numbered in the order they happen
ellipse "1" at 236,84 24x24 stroke=none title.size=9 fill=ink/0.08
text "Order" at 248,124 style=eyebrow anchor=middle
ellipse "2" at 388,84 24x24 stroke=none title.size=9 fill=ink/0.08
text "Verify" at 400,124 style=eyebrow anchor=middle
ellipse "3" at 540,84 24x24 stroke=none title.size=9 fill=accent/0.16 title.color=accent
text "Allocate" at 552,124 style=eyebrow anchor=middle color=accent
ellipse "4" at 692,84 24x24 stroke=none title.size=9 fill=ink/0.08
text "Pick" at 704,124 style=eyebrow anchor=middle
ellipse "5" at 844,84 24x24 stroke=none title.size=9 fill=ink/0.08
text "Pack" at 856,124 style=eyebrow anchor=middle
ellipse "6" at 996,84 24x24 stroke=none title.size=9 fill=ink/0.08
text "Pay" at 1008,124 style=eyebrow anchor=middle
ellipse "7" at 1148,84 24x24 stroke=none title.size=9 fill=ink/0.08
text "Receive" at 1160,124 style=eyebrow anchor=middle
ellipse "8" at 1300,84 24x24 stroke=none title.size=9 fill=ink/0.08
text "Close" at 1312,124 style=eyebrow anchor=middle

// one box where an actor does a step: name, what comes in → what goes out, the tool
place: node tag="CUS" at 184,148 128x72
text "Place order" at 248,184 weight=600 anchor=middle
text "cart → order" at 248,199 style=small anchor=middle
text "storefront" at 248,211 style=small anchor=middle color=soft
verify: node tag="SUP" at 336,244 128x72
text "Verify order" at 400,280 weight=600 anchor=middle
text "order → cleared" at 400,295 style=small anchor=middle
text "service desk" at 400,307 style=small anchor=middle color=soft
alloc: focal tag="WHS" at 488,340 128x72
text "Allocate stock" at 552,376 weight=600 anchor=middle
text "order → pick list" at 552,391 style=small anchor=middle
text "inventory system" at 552,403 style=small anchor=middle color=soft
pick: node tag="WHS" at 640,340 128x72
text "Pick items" at 704,376 weight=600 anchor=middle
text "list → picked" at 704,391 style=small anchor=middle
text "handheld scanner" at 704,403 style=small anchor=middle color=soft
pack: node tag="WHS" at 792,340 128x72
text "Pack order" at 856,376 weight=600 anchor=middle
text "picked → shipment" at 856,391 style=small anchor=middle
text "packing station" at 856,403 style=small anchor=middle color=soft
pay: node tag="FIN" at 944,436 128x72
text "Capture payment" at 1008,472 weight=600 anchor=middle
text "shipment → receipt" at 1008,487 style=small anchor=middle
text "payment gateway" at 1008,499 style=small anchor=middle color=soft
receive: node tag="CUS" at 1096,148 128x72
text "Receive shipment" at 1160,184 weight=600 anchor=middle
text "receipt → confirmed" at 1160,199 style=small anchor=middle
text "delivery portal" at 1160,211 style=small anchor=middle color=soft
close: node tag="SUP" at 1248,244 128x72
text "Close order" at 1312,280 weight=600 anchor=middle
text "confirmed → closed" at 1312,295 style=small anchor=middle
text "service desk" at 1312,307 style=small anchor=middle color=soft

// handoffs: out of the right side, into the top or bottom of the next box
place.right -> verify.top
verify.right -> alloc.top style=primary
alloc -> pick style=primary
pick -> pack
pack.right -> pay.top
pay.right -> receive.bottom
receive.right -> close.top

legend at 40,544 node="A step, in the lane of who does it" focal="The step everything waits for" primary="Critical handoff" arrow="Handoff"
