// Cloudflare deploy for fastdraw.dev: a static site (landing page at /, editor at /edit/, llms.txt),
// and a Worker that draws diagrams as SVG images at /gh/* and /s/*.
// Build: npm run build:editor   Deploy: npx wrangler deploy
{
  "name": "fastdraw",
  "compatibility_date": "2026-10-01",
  // /gh/* and /s/*: diagrams drawn as SVG images for GitHub READMEs (worker/svg.ts); the rest is static
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist-editor",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/gh/*", "/s/*"]
  },
  // branch builds run `wrangler preview`, which needs this block (empty is enough)
  "previews": {},
  // matches the Worker's settings in the Cloudflare dashboard, so builds do not see a mismatch
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  }
}
