# Text boxes: width= wraps the text and align= places each line in the box.
a: text "The quick brown fox jumps over the lazy dog and keeps on running" at 40,40 width=160
b: text "Centred lines in a box that is wide enough for two" at 240,40 width=180 align=center
c: text "Right-aligned, with\na written line break and a long tail" at 460,40 width=150 align=right size=14 caps=1
d: text "Echoed and boxed" at 40,160 width=120 align=center echo=accent
e: text "Turned box text reading up" at 40,320 width=100 rotate=-90 align=right
f: text "A supercalifragilisticexpialidocious word" at 240,160 width=60
# problems: a width that is not a number, an unknown align, align without a box, anchor on a box
g: text "bad width" at 240,240 width=wide
h: text "bad align" at 240,270 width=100 align=justify
i: text "no box" at 240,300 align=center
j: text "anchored box" at 240,330 width=100 anchor=middle
k: text "right, no box" at 240,360 align=right
l: text "end anchor box" at 240,390 width=100 anchor=end
