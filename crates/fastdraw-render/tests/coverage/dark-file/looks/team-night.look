// The team's look after dark: its own icons and its own font.
canvas paper=paper dots=ink/0.1
color paper #101624
color ink #e8ecf4
color muted #9aa3b5
color accent #4cc2ff
font sans "Night Hand"
fontdir "./night-fonts"
icondir "./night-icons"
style node shape=rect radius=6 size=160x64 fill=#18213a stroke=ink/0.35 sw=1.2
style arrow line stroke=ink/0.7 sw=1.3 route=ortho radius=6
