# Legends: one sized and one as wide as the drawing; entries for shape, line and text styles and for plain
# swatches, dots and lines.
a: rect "A" at 40,40 120x48
b: diamond "B" at 300,40 120x80
c: text "a note" at 500,60
a -> b
k1: legend at 40,200 rect="a box" diamond="a decision" ellipse="an ellipse" arrow="a call" line="a plain line" relation="a relation" text="a note" swatch.#3355aa="blue" dot.#aa3333="red dot" line.ink="ink line" swatch.ink/0.2="tint"
k2: legend at 40,300 400x40 title="Key" title.caps=0 title.size=10 title.font=sans title.color=#663399 title.weight=700 title.italic=1 title.spacing=0 item.size=10 item.font=mono item.color=#333333 item.weight=600 item.italic=1 item.spacing=0.05 rule=#3355aa arrow="first" line="second" rect="third" ellipse="fourth" diamond="fifth" text="sixth" swatch.#ffd400="seventh"
k3: legend at 40,400 title=none
k4: legend at 520,400 300x40 table="tables" chart="charts" icon="icons" polygon="polygons" bar="a bar" style=legend
