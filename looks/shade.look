// Shade: hairline cards on white-smoke paper, each casting a shadow of fine drawn lines. A tall serif
// title, typewriter capitals for technical labels, one indigo for the subject. The quietest of the style
// looks, after diagram-design. Same style names as the built-in look.

canvas paper=paper

// the look the dark theme and "fastdraw render --dark" draw this look with
dark shade-dark

color paper    #f5f5f5
color card     #ffffff
color ink      #2d3142
color muted    #4f5d75
color soft     #8a93a6
color accent   #4f46e5
color tint     #eceafd
color link     #2e5aa8
color teal     #0d9488
color amber    #b7791f
color rose     #c2410c
color violet   #7c3aed

font sans  "Geist"
font mono  "Geist Mono"
font serif "Instrument Serif"

// ---- boxes -----------------------------------------------------------------
style node shape=rect radius=2 size=144x64 fill=card stroke=ink sw=1 shade=ink/0.7 sub.font=mono sub.color=muted
    tag.color=muted tag.border=ink/0.3 tag.font=mono icon.color=ink use="default box: a backend, service, component or step"
style focal extends node fill=tint stroke=accent shade=accent shade.sw=0.8 sub.color=accent
    tag.color=accent tag.border=accent/0.5 icon.color=accent ghost.color=accent/0.12 use="the one or two elements the diagram is about"
style store extends node shape=path path="M0,0.1 C0,-0.035 1,-0.035 1,0.1 L1,0.9 C1,1.035 0,1.035 0,0.9 Z M0,0.1 C0,0.235 1,0.235 1,0.1 C1,0.235 0,0.235 0,0.1" use="something that holds data or state"
style cloud extends node stroke=link shade=link/0.8 icon.color=link tag.color=link tag.border=link/0.5 use="a hosted or third-party platform"
style external extends node fill=paper stroke=ink/0.5 dash=4,3 shade=none icon.color=muted use="a person or system outside what you own"
style optional extends node fill=paper stroke=ink/0.4 dash=2,3 shade=none tag.color=soft tag.border=ink/0.2 use="optional or asynchronous participant"
style sticky extends node radius=0 size=120x120 fill=#fff3bf stroke=ink/0.35 shade=ink/0.45 tag.color=ink tag.border=ink/0.3 use="a yellow sticky note: an idea, comment or open question"
style sticky-orange extends sticky fill=#ffe1d6 use="an orange sticky note: a risk or issue"
style sticky-violet extends sticky fill=#e9e4ff use="a violet sticky note: a decision or note"

// ---- flowchart shapes ------------------------------------------------------
style step extends node size=160x48 use="flowchart action"
style terminal extends node radius=24 size=160x48 use="flowchart start or end"
style terminal-focal extends terminal fill=tint stroke=accent shade=accent shade.sw=0.8 use="the flowchart outcome that matters most"
style decision shape=diamond size=200x96 fill=card stroke=ink sw=1 shade=ink/0.7 use="flowchart yes/no question; put the text on two short lines"

// ---- regions and markers ---------------------------------------------------
style zone shape=rect radius=0 fill=none hatch=ink/0.1 hatch.gap=6 hatch.sw=0.4 stroke=#bfc0c0 sw=1 layer=back
    title.pos=top title.dy=-10 title.align=left title.font=mono title.size=8 title.weight=500 title.color=soft title.spacing=0.18 title.caps=1 use="a labelled region drawn behind a group of boxes; always give WxH"
style bar shape=rect radius=0 size=8x80 fill=tint stroke=accent sw=1 use="sequence diagram activation bar, centred on a lifeline; always give WxH"
style table shape=table radius=2 fill=card stroke=ink sw=1 shade=ink/0.7 head.fill=ink/0.06 rule=ink/0.1
    cell.font=mono cell.size=10 detail.color=muted use="an entity, class or database table: a header and rows. One line per row: | id \"name\" \"type\" \"key\". Arrows can end on a row: orders.user_id -> users.id"
style matrix extends table align=center grid=1 cell.font=sans use="a grid of values: first row with |= for the column headings, first cell of each row is its name"
style chart shape=chart fill=none stroke=ink/0.6 sw=1 mask=0 bar.radius=0 grid.color=ink/0.08
    tick.font=mono tick.size=9 tick.color=muted use="axes with your numbers drawn for you: chart at x,y WxH x=\"Q1,Q2,Q3\" y=0..100, then a line per series: | bars \"Revenue\" 42 61 75"

// ---- lines -----------------------------------------------------------------
style arrow line stroke=muted sw=1 route=ortho radius=8 label.font=mono label.size=8 label.color=muted label.spacing=0.06 use="default arrow"
style primary extends arrow stroke=accent sw=1.6 label.color=accent use="the main path; at most two per diagram"
style link extends arrow stroke=link label.color=link use="an HTTP or API request crossing a boundary"
style return extends arrow dash=5,4 use="a response, or something optional or asynchronous"
style relation extends relation stroke=ink/0.7 label.font=mono label.size=8
style lifeline line head=none stroke=ink/0.3 sw=1 dash=4,4 route=straight use="sequence diagram lifeline"
style rule line head=none stroke=#bfc0c0 sw=1 route=straight use="thin separator, e.g. above a legend"

// ---- text ------------------------------------------------------------------
style h1 text font=serif size=36 weight=400 color=ink use="diagram title"
style kicker text font=mono size=9 weight=500 color=accent spacing=0.14 caps=1 use="optional: a short category above the title, e.g. PROCESS"
style dek text font=sans size=13 color=muted use="optional: one line under the title saying what the diagram shows"
style eyebrow text font=mono size=8 color=soft spacing=0.16 caps=1 use="small caps label, e.g. LEGEND"
style caption text font=sans size=9.5 color=muted use="small explanatory text"
style legend extends legend rule=ink/0.12 title.font=mono item.size=9.5
style note text font=serif italic=1 size=16 color=ink use="a short aside; at most two"
style small text font=mono size=9 color=muted use="technical detail: a port, path or command"

guidance "focal, terminal-focal and primary are the accent. Use the accent on at most two things in one diagram."
guidance "Never fill a shape with ink to make it stand out; use focal."
guidance "tag= is a 3 or 4 letter type marker in the corner of a box (EXT, EDGE, API, DB). Use it on architecture boxes, not flowchart shapes."
guidance "sub= is a short second line of detail: a product name, path, port or protocol. Names of things go in the main text."
guidance "kicker and dek are optional. Add a kicker only when the diagram belongs to a named category, and a dek only when there is one clear message; most diagrams need neither."
guidance "Finish with a legend: one statement, 'legend at x,y' followed by style=\"what it means\" for each style you used."
