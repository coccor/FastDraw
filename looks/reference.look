// Reference look for the quality comparison.
// It mirrors the palette and type of diagram-design's default skin so the two can be
// judged side by side. It is a test fixture, not the look FastDraw will ship with.

canvas paper=paper dots=ink/0.055 dotgap=22

// the look the dark theme and "fastdraw render --dark" draw this look with
dark reference-dark

color paper  #f5f5f5
color ink    #2d3142
color muted  #4f5d75
color soft   #7a8399
color accent #eb6c36
color link   #2e5aa8

font sans  "Geist"
font mono  "Geist Mono"
font serif "Instrument Serif"

// ---- boxes ----------------------------------------------------------------
style node shape=rect radius=6 size=144x64 fill=#ffffff stroke=ink sw=1
    tag.color=ink tag.border=ink/0.4
    use="default box: a backend, service, component or step"
style focal extends node fill=accent/0.08 stroke=accent
    tag.color=accent tag.border=accent/0.5 ghost.color=accent/0.10
    use="the one or two elements the diagram is about"
style store extends node fill=ink/0.05 stroke=muted tag.color=muted tag.border=muted/0.5
    use="something that holds data or state"
style cloud extends node fill=ink/0.03 stroke=ink/0.30 tag.color=soft tag.border=ink/0.22
    use="a hosted or third-party platform"
style external extends node fill=muted/0.10 stroke=soft tag.color=soft tag.border=soft/0.4
    use="a person or system outside what you own"
style optional extends node fill=ink/0.02 stroke=ink/0.22 dash=4,3 tag.color=soft tag.border=ink/0.22
    use="optional or asynchronous participant"
style sticky extends node size=120x120 fill=#fdf0a6 stroke=ink/0.25 tag.color=ink tag.border=ink/0.3
    use="a yellow sticky note: an idea, comment or open question"
style sticky-orange extends sticky fill=#fdd8b8 use="an orange sticky note: a risk or issue"
style sticky-violet extends sticky fill=#e2dbfb use="a violet sticky note: a decision or note"

// ---- flowchart shapes -----------------------------------------------------
style step extends node size=160x48 use="flowchart action"
style terminal shape=rect radius=24 size=160x48 fill=ink/0.03 stroke=ink/0.30 sw=1
    use="flowchart start or end"
style terminal-focal extends terminal fill=accent/0.08 stroke=accent
    use="the flowchart outcome that matters most"
style decision shape=diamond size=200x96 fill=#ffffff stroke=ink sw=1
    use="flowchart yes/no question; put the text on two short lines"

// ---- other shapes ---------------------------------------------------------
style zone shape=rect radius=8 fill=ink/0.02 stroke=ink/0.10 sw=0.8 layer=back
    title.pos=top title.font=mono title.size=7 title.weight=400 title.color=ink/0.40 title.spacing=0.14 title.caps=1
    use="a labelled region drawn behind a group of boxes; always give WxH"
style bar shape=rect size=8x80 fill=ink/0.06 stroke=muted sw=0.8
    use="sequence diagram activation bar, centred on a lifeline; always give WxH"

style table shape=table radius=6 fill=#ffffff stroke=ink sw=1 head.fill=ink/0.06 rule=ink/0.1
    cell.font=mono cell.size=9.5 detail.color=muted
    use="an entity, class or database table: a header and rows. One line per row: | id \"name\" \"type\" \"key\". Arrows can end on a row: orders.user_id -> users.id"
style matrix extends table align=center grid=1 cell.font=sans
    use="a grid of values: first row with |= for the column headings, first cell of each row is its name"
style chart shape=chart fill=none stroke=ink/0.5 sw=1 mask=0 bar.radius=2 grid.color=ink/0.07
    tick.font=mono tick.size=8 tick.color=muted
    use="axes with your numbers drawn for you: chart at x,y WxH x=\"Q1,Q2,Q3\" y=0..100, then a line per series: | bars \"Revenue\" 42 61 75"

// ---- lines ----------------------------------------------------------------
style arrow line stroke=muted sw=1.2 route=ortho radius=8 label.font=mono label.size=8 label.spacing=0.08
    use="default arrow"
style primary extends arrow stroke=accent sw=1.4 use="the main path; at most two per diagram"
style link extends arrow stroke=link use="an HTTP or API request crossing a boundary"
style return extends arrow dash=5,4 use="a response, or something optional or asynchronous"
style relation extends relation label.font=mono label.size=8 label.spacing=0.08
style lifeline line head=none stroke=ink/0.22 sw=1 dash=3,3 route=straight use="sequence diagram lifeline"
style rule line head=none stroke=ink/0.10 sw=0.8 route=straight use="thin separator, e.g. above a legend"

// ---- text -----------------------------------------------------------------
style h1 text font=serif size=28 color=ink use="diagram title"
style kicker text font=mono size=9 color=accent spacing=0.18 caps=1 use="optional: a short category above the title, e.g. PROCESS"
style dek text font=sans size=14 color=muted use="optional: one line under the title saying what the diagram shows"
style eyebrow text font=mono size=8 color=muted spacing=0.18 caps=1 use="small caps label, e.g. LEGEND"
style caption text font=sans size=8.5 color=muted use="legend entry"
style legend extends legend title.size=7.5 item.font=sans item.size=8.5
style note text font=serif italic=1 size=14 color=muted use="a short editorial aside; at most two"
style small text font=mono size=9 color=muted use="technical detail: a port, path or command"

guidance "focal, terminal-focal and primary are the accent. Use the accent on at most two things in one diagram."
guidance "tag= is a 3 or 4 letter type marker in the corner of a box (EXT, EDGE, API, DB). Use it on architecture boxes, not flowchart shapes."
guidance "sub= is for technical detail in mono type: a product name, path, port or protocol. Names of things go in the main text."
guidance "Finish with a legend: one statement, 'legend at x,y' followed by style=\"what it means\" for each style you used."
