// Sketch dark: Sketch on a dark page, like a whiteboard tool's dark mode. Marker-weight outlines that
// wobble, the handwritten font, deep pastel fills and pencil hatching for the subject. Near-black page,
// near-white ink, one bright blue for what the diagram is about. Same styles and sizes as Sketch.

canvas paper=paper sketch=1

// already dark, so "fastdraw render --dark" and the dark theme draw this look too
dark sketch-dark
fontdir "./fonts"

color paper  #121316
color ink    #e6e6ea
color muted  #b0b4bb
color soft   #7c828b
color accent #4dabf7
color sky    #1f4f78
color mint   #2c5c38
color leaf   #69db7c
color butter #5a4c17
color amber  #ffa94d
color rose   #6e2f35
color link   #9775fa

font sans  "Sketch Hand"
font serif "Sketch Hand"
font mono  "Geist Mono"

// ---- boxes ----------------------------------------------------------------
style node shape=rect radius=10 size=144x64 fill=paper stroke=ink sw=2
    title.font=sans title.size=14 title.weight=400 title.color=ink sub.font=sans sub.size=10.5 sub.color=muted
    tag.font=sans tag.size=9 tag.color=muted tag.border=ink/0.35
    use="default box: a backend, service, component or step"
style focal extends node fill=sky/0.35 hatch=accent/0.5 hatch.gap=8 hatch.sw=1.2 stroke=accent
    title.color=ink tag.color=accent tag.border=accent/0.6 ghost.color=accent/0.12
    use="the one or two elements the diagram is about"
style store extends node size=144x72
    path="M0,0.1 C0,-0.035 1,-0.035 1,0.1 L1,0.9 C1,1.035 0,1.035 0,0.9 Z M0,0.1 C0,0.235 1,0.235 1,0.1 C1,0.235 0,0.235 0,0.1"
    shape=path fill=butter stroke=ink
    use="something that holds data or state"
style cloud extends node fill=mint/0.7 stroke=leaf tag.color=leaf tag.border=leaf/0.5
    use="a hosted or third-party platform"
style external extends node fill=paper stroke=muted dash=8,7 tag.color=soft
    use="a person or system outside what you own"
style optional extends node fill=paper stroke=soft dash=2,6 tag.color=soft
    use="optional or asynchronous participant"
style sticky extends node size=128x128 radius=4 fill=butter stroke=ink sw=1.5
    use="a yellow sticky note: an idea, comment or open question"
style sticky-orange extends sticky fill=#5c3a17 use="an orange sticky note: a risk or issue"
style sticky-violet extends sticky fill=#3c3166 use="a violet sticky note: a decision or note"

// ---- flowchart shapes -----------------------------------------------------
style step extends node size=160x56 use="flowchart action"
style terminal extends node shape=ellipse size=168x60 fill=rose/0.6
    use="flowchart start or end"
style terminal-focal extends terminal fill=sky/0.35 hatch=accent/0.5 hatch.gap=8 hatch.sw=1.2 stroke=accent
    use="the flowchart outcome that matters most"
style decision extends node shape=diamond size=208x104 fill=butter/0.8
    use="flowchart yes/no question; put the text on two short lines"

// ---- other shapes ---------------------------------------------------------
style zone shape=rect radius=12 fill=none stroke=soft sw=1.5 dash=10,8 layer=back
    title.pos=top title.font=sans title.size=13 title.weight=400 title.color=muted
    use="a labelled region drawn behind a group of boxes; always give WxH"
style bar shape=rect size=10x80 fill=sky/0.5 stroke=ink sw=1.5
    use="sequence diagram activation bar, centred on a lifeline; always give WxH"

style table shape=table radius=6 fill=paper stroke=ink sw=2 head.fill=sky/0.45 rule=ink/0.2
    title.font=sans title.size=14 title.weight=400 cell.font=sans cell.size=12 detail.color=muted
    use="an entity, class or database table: a header and rows. One line per row: | id \"name\" \"type\" \"key\". Arrows can end on a row: orders.user_id -> users.id"
style matrix extends table align=center grid=1
    use="a grid of values: first row with |= for the column headings, first cell of each row is its name"
style chart shape=chart fill=none stroke=ink sw=1.5 mask=0 bar.radius=3 grid.color=ink/0.1
    tick.font=sans tick.size=11 tick.color=muted
    use="axes with your numbers drawn for you: chart at x,y WxH x=\"Q1,Q2,Q3\" y=0..100, then a line per series: | bars \"Revenue\" 42 61 75"

// ---- lines ----------------------------------------------------------------
style arrow line stroke=ink sw=2 route=ortho radius=14 label.font=sans label.size=12 label.spacing=0 label.caps=0 label.color=muted
    use="default arrow"
style primary extends arrow stroke=accent sw=2.5 label.color=accent use="the main path; at most two per diagram"
style link extends arrow stroke=link label.color=link use="an HTTP or API request crossing a boundary"
style return extends arrow stroke=muted dash=8,7 use="a response, or something optional or asynchronous"
style relation extends relation sw=1.8 label.font=sans label.size=12 label.spacing=0 label.caps=0
style lifeline line head=none stroke=soft sw=1.5 dash=6,6 route=straight use="sequence diagram lifeline"
style rule line head=none stroke=ink/0.25 sw=1.5 route=straight use="thin separator, e.g. above a legend"

// ---- text -----------------------------------------------------------------
style h1 text font=sans size=30 weight=400 color=ink use="diagram title"
style kicker text font=sans size=13 color=accent use="optional: a short category above the title"
style dek text font=sans size=16 color=muted use="optional: one line under the title saying what the diagram shows"
style eyebrow text font=sans size=12 color=muted use="small heading, e.g. Legend"
style caption text font=sans size=11 color=muted use="small explanatory text"
style legend extends legend title.font=sans title.size=13 title.caps=0 title.spacing=0 item.font=sans item.size=12
style note text font=sans size=16 color=accent use="a short handwritten aside; at most two"
style small text font=mono size=10 color=muted use="technical detail: a port, path or command"

guidance "Everything is drawn by hand (canvas sketch=1). Keep diagrams loose and roomy: the handwriting is wider than a normal sans, so give boxes a little more width."
guidance "focal, terminal-focal and primary are the accent blue. Use the accent on at most two things in one diagram."
guidance "Colour by meaning with the pastel fills: fill=sky/0.5, fill=mint/0.7, fill=butter, fill=rose/0.6. Never fill a shape with ink."
guidance "hatch=colour fills a shape with pencil hatching; hatch.gap spaces the lines."
guidance "Finish with a legend: one statement, 'legend at x,y' followed by style=\"what it means\" for each style you used."
