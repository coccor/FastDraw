// Candidate C, "Brand". Drawn like the FastDraw logo: soft filled blocks with generous round
// corners, no outlines, thick rounded connectors, the logo green as the one accent. Plus Jakarta Sans.
fontdir "./fonts"
canvas paper=ground

color ground #ffffff
color ink    #0f2e28
color muted  #4f6862
color soft   #a9bdb7
color tint   #e6f1ed
color accent #0e7c66
color link   #f0563c

font sans  "Plus Jakarta Sans"
font mono  "IBM Plex Mono"
font serif "Plus Jakarta Sans"

style node shape=rect radius=14 size=144x64 fill=tint stroke=none sw=0
    title.weight=700 sub.size=10 sub.color=muted tag.color=muted tag.border=ink/0.2
    use="default box: a service, component or step"
style focal extends node fill=accent title.color=#ffffff sub.color=#ffffff/0.85 tag.color=#ffffff tag.border=#ffffff/0.5 ghost.color=#ffffff/0.18
    use="the one or two elements the diagram is about"
style store extends node size=144x72
    path="M0,0.1 C0,-0.035 1,-0.035 1,0.1 L1,0.9 C1,1.035 0,1.035 0,0.9 Z M0,0.1 C0,0.235 1,0.235 1,0.1 C1,0.235 0,0.235 0,0.1"
    shape=path fill=tint stroke=#ffffff sw=2 use="something that holds data or state"
style cloud extends node fill=link/0.1 use="a hosted or third-party platform"
style external extends node fill=none stroke=soft sw=2 dash=6,5 use="a person or system outside what you own"
style optional extends node fill=none stroke=soft sw=2 dash=2,5 use="optional or asynchronous participant"
style step extends node size=160x48 use="flowchart action"
style terminal shape=rect radius=24 size=160x48 fill=ink stroke=none title.weight=700 title.color=#ffffff sub.color=#ffffff/0.8 sub.size=10 use="flowchart start or end"
style terminal-focal extends terminal fill=accent use="the flowchart outcome that matters most"
style decision shape=diamond size=200x96 fill=tint stroke=none title.weight=700 use="flowchart yes/no question"
style zone shape=rect radius=22 fill=accent/0.035 stroke=accent/0.18 sw=1.5 dash=none layer=back
    title.pos=top title.font=sans title.size=11 title.weight=700 title.color=accent
    use="a labelled region drawn behind a group of boxes; always give WxH"
style bar shape=rect size=8x80 fill=tint stroke=none use="sequence activation bar"
style table shape=table radius=14 fill=#ffffff stroke=soft sw=1.5 head.fill=tint rule=ink/0.08 cell.font=mono cell.size=10 detail.color=muted use="a table"
style matrix extends table align=center grid=1 cell.font=sans use="a grid of values"
style arrow line stroke=soft sw=2.5 route=ortho radius=14 label.font=sans label.size=10 label.weight=600 label.caps=0 label.spacing=0 label.color=muted use="default arrow"
style primary extends arrow stroke=accent sw=3.5 label.color=accent use="the main path"
style link extends arrow stroke=link label.color=link use="a request crossing a boundary"
style return extends arrow stroke=soft dash=5,5 use="a response"
style relation extends relation stroke=soft sw=2 label.font=sans label.size=10 label.color=muted
style lifeline line head=none stroke=soft sw=1.5 dash=2,5 route=straight use="lifeline"
style rule line head=none stroke=ink/0.1 sw=1.5 route=straight use="thin separator"
style h1 text font=sans size=24 weight=700 color=ink use="diagram title"
style eyebrow text font=sans size=10 weight=700 color=accent use="small heading"
style caption text font=sans size=10 color=muted use="small explanatory text"
style note text font=sans size=14 weight=500 color=muted use="a short aside"
style small text font=mono size=9 color=muted use="technical detail"
