// Candidate E, "Aubergine". A dark plum ground with a faint grid, quiet violet-grey boxes,
// the subject glowing in apricot. Geist and Geist Mono. Made for dark-mode docs and slides.
canvas paper=ground dots=ink/0.07 dotgap=20

color ground #170f20
color sheet  #241a31
color ink    #f3eefa
color muted  #ab9dc0
color soft   #625374
color accent #ff9f5a
color link   #8ab4ff

font sans  "Geist"
font mono  "Geist Mono"
font serif "Instrument Serif"

style node shape=rect radius=8 size=144x64 fill=sheet stroke=ink/0.2 sw=1
    title.weight=500 sub.font=mono sub.size=9 sub.color=muted tag.font=mono tag.color=muted tag.border=ink/0.25
    use="default box: a service, component or step"
style focal extends node fill=accent/0.13 stroke=accent sw=1.5 title.color=accent sub.color=accent/0.75 tag.color=accent tag.border=accent/0.5 ghost.color=accent/0.15
    use="the one or two elements the diagram is about"
style store extends node size=144x72
    path="M0,0.1 C0,-0.035 1,-0.035 1,0.1 L1,0.9 C1,1.035 0,1.035 0,0.9 Z M0,0.1 C0,0.235 1,0.235 1,0.1 C1,0.235 0,0.235 0,0.1"
    shape=path fill=sheet use="something that holds data or state"
style cloud extends node fill=link/0.1 stroke=link/0.5 use="a hosted or third-party platform"
style external extends node fill=none stroke=ink/0.35 dash=4,4 use="a person or system outside what you own"
style optional extends node fill=none stroke=soft dash=2,4 use="optional or asynchronous participant"
style step extends node size=160x48 use="flowchart action"
style terminal shape=rect radius=24 size=160x48 fill=ink stroke=none title.weight=600 title.color=ground sub.color=ground/0.7 sub.font=mono sub.size=9 use="flowchart start or end"
style terminal-focal extends terminal fill=accent use="the flowchart outcome that matters most"
style decision shape=diamond size=200x96 fill=sheet stroke=ink/0.3 sw=1 use="flowchart yes/no question"
style zone shape=rect radius=12 fill=ink/0.025 stroke=ink/0.12 sw=1 dash=none layer=back
    title.pos=top title.align=left title.font=mono title.size=9 title.caps=1 title.spacing=0.1 title.color=muted
    use="a labelled region drawn behind a group of boxes; always give WxH"
style bar shape=rect size=8x80 fill=sheet stroke=ink/0.3 sw=1 use="sequence activation bar"
style table shape=table radius=8 fill=sheet stroke=ink/0.2 sw=1 head.fill=ink/0.06 rule=ink/0.08 cell.font=mono cell.size=10 detail.color=muted use="a table"
style matrix extends table align=center grid=1 cell.font=sans use="a grid of values"
style arrow line stroke=ink/0.45 sw=1.3 route=ortho radius=8 label.font=mono label.size=9 label.caps=0 label.spacing=0 label.color=muted use="default arrow"
style primary extends arrow stroke=accent sw=2 label.color=accent use="the main path"
style link extends arrow stroke=link label.color=link use="a request crossing a boundary"
style return extends arrow stroke=muted dash=4,4 use="a response"
style relation extends relation stroke=ink/0.45 label.font=mono label.size=9 label.color=muted
style lifeline line head=none stroke=soft sw=1 dash=2,4 route=straight use="lifeline"
style rule line head=none stroke=ink/0.12 sw=1 route=straight use="thin separator"
style h1 text font=sans size=22 weight=600 color=ink use="diagram title"
style eyebrow text font=mono size=9 color=muted use="small heading"
style caption text font=sans size=10 color=muted use="small explanatory text"
style note text font=serif italic=1 size=15 color=muted use="a short aside"
style small text font=mono size=9 color=muted use="technical detail"
