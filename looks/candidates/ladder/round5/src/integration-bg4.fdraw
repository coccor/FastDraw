lab:   external "Laboratory (LIS)" at 40,232 160x64
pharm: external "Pharmacy" at 40,320 160x64
reg:   external "Registration (ADT)" at 40,408 160x64

ehr:   external "Patient record" at 1000,232 160x64
bill:  external "Billing" at 1000,320 160x64
rep:   external "Reporting" at 1000,408 160x64

orch: cloud "Workflow orchestrator" at 296,168 608x56
eng:  focal "Interface engine" at 344,316 160x72
api:  focal "FHIR API" at 696,316 160x72

idp:  cloud "Identity" at 40,544 262x48
aud:  cloud "Audit log" at 326,544 262x48
sec:  cloud "Secrets" at 612,544 262x48
mon:  cloud "Monitoring" at 898,544 262x48

